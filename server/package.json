{
  "name": "ai-coding-alerts-server",
  "private": true,
  "version": "0.1.0",
  "description": "Licensing backend for AI Coding Alerts — Cloudflare Workers + D1 + Paddle. Independent of the extension; deployed separately.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:apply:local": "wrangler d1 execute ai-coding-alerts --local --file=./schema.sql",
    "db:apply:remote": "wrangler d1 execute ai-coding-alerts --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240000.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.60.0"
  }
}
