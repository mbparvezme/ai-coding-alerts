# Public, build-time (inlined by Next). Gitignored. Sandbox first.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle sandbox CLIENT-SIDE token (Paddle → Developer tools → Authentication →
# Client-side tokens). This is NOT the API key — it starts with `test_` (sandbox)
# / `live_` and is safe to expose in the browser bundle. Paste yours below:
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_f8008ac569bb432ec489a8d10d2
